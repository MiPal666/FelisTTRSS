        <file alias="ic_rss_enabled.png">images/resources/ic_rss_enabled.png</file>
        <file alias="ic_star.svg">images/resources/material/star_black_48dp.svg</file>
        <file alias="ic_read.svg">images/resources/material/check_circle_black_48dp.svg</file>
        <file alias="ic_unread.svg">images/resources/material/circle_black_48dp.svg</file>
        <file alias="ic_refresh.svg">images/resources/material/refresh_black_48dp.svg</file>
